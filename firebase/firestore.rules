rules_version = '2';

// মাজেদার লাইব্রেরি — Firestore security rules.
// `firebase deploy` publishes this file. (Without the CLI: paste the whole
// file into Firebase console → Firestore Database → Rules → Publish.)
//
// A library lives at libraries/{libId}; libId is the owner's account id.
//  - The owner can always use it.
//  - The owner may list up to 10 email addresses in `members`; an account
//    signed in with one of those addresses, verified by Google, can use the
//    library too (read and write the books), but cannot change the list.
//  - Book writes must carry the server's timestamp (the sync engine relies on
//    it to pull changes in order) and nothing is ever deleted: deleting a book
//    in the app only marks it as deleted, so nothing can be lost from the cloud.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function verified() {
      return request.auth.token.email_verified == true && request.auth.token.email is string;
    }
    function isOwner(libId) {
      return signedIn() && request.auth.uid == libId;
    }
    function isMember(libId) {
      return signedIn() && verified()
        && myEmail() in get(/databases/$(database)/documents/libraries/$(libId)).data.members;
    }
    function validCard(libId) {
      let d = request.resource.data;
      return d.owner == libId
        && d.members is list && d.members.size() <= 10
        && d.keys().hasOnly(['owner', 'ownerEmail', 'ownerName', 'members', 'createdAt']);
    }

    // The library card: who owns it and who it is shared with.
    match /libraries/{libId} {
      allow get: if isOwner(libId)
        || (signedIn() && verified() && myEmail() in resource.data.members);
      // "Which libraries were shared with me?" — only matches the caller's own email.
      allow list: if signedIn() && verified() && myEmail() in resource.data.members;
      allow create: if isOwner(libId) && validCard(libId);
      allow update: if isOwner(libId) && validCard(libId) && request.resource.data.owner == resource.data.owner;
      allow delete: if false;
    }

    // The books, folders and covers.
    match /libraries/{libId}/{coll}/{docId} {
      allow read: if isOwner(libId) || isMember(libId);
      allow create, update: if (isOwner(libId) || isMember(libId))
        && coll in ['records', 'covers']
        && request.resource.data.id == docId
        && request.resource.data._v is map
        && request.resource.data._srv == request.time;
      allow delete: if false;
    }
  }
}
